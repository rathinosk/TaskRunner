{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      // Copilot Chat is disabled in the dev host: with --extensionDevelopmentPath it enables API proposals that
      // product.json does not list, and the extension host aborts (exit 134) about a second after start.
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extension=GitHub.copilot-chat"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
